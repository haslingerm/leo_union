<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>LeoUnion</RootNamespace>
        <AssemblyName>LeoUnion</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>HTLLeonding.Utility.LeoUnion</PackageId>
        <Version>1.0.1</Version>
        <Title>HTL Leonding Union Types</Title>
        <Description>Generic ad-hoc union types for C# 15: Union&lt;T1, ..., T10&gt;, plus marker types for common outcomes (Success, NotFound, Conflict, Error)</Description>
        <Authors>M. Haslinger</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageTags>HTL-Leonding;union;unions;discriminated-union;csharp15</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/haslingerm/leo_union</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../Readme.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HTLLeonding.Utility.LeoAnalyzers" Version="1.3.1" PrivateAssets="all" />
    </ItemGroup>

</Project>
